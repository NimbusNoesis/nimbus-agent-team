{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/server/scripts/ensure-build.sh\" \"${CLAUDE_PLUGIN_ROOT}/server\" \"${CLAUDE_PLUGIN_DATA}\" >/dev/null 2>&1 || true",
            "timeout": 600
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/server/scripts/ensure-build.sh\" \"${CLAUDE_PLUGIN_ROOT}/server\" \"${CLAUDE_PLUGIN_DATA}\" >/dev/null 2>&1 || true",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
